# Copy to .env (gitignored) or let `mise run bootstrap-env` create it.
# CLIENT_SECRET is the Azure service-principal secret — the one value you supply
# out-of-band (export it or paste it here). CF_ACCESS_* are pulled from Key Vault
# by `mise run pull-secrets`. WORKSTATION_NAME defaults to the hostname.
CLIENT_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
WORKSTATION_NAME=
